node_modules/
.next/
dist/
coverage/
.turbo/
.env
.env.*
!.env.example

# Azure connections (IDs of customer tenants) — never committed; see config/connections.example.json
config/connections.json
config/tenants.json
# Diagrams / notes of real environments (subscription / resource IDs) — local only: name them *.local.md or keep them
# under .secrets/ (scripts/gp.sh adds everything)
*.local.md
/local/
# Local read-only probes against real tenants (print tenant facts) — never committed
apps/api/.probe/

# On-prem container deployment: filled env files, connections, certificates — never committed
deploy/docker/*.env
deploy/docker/config/
deploy/docker/tls/
# SSH / TLS private keys — never committed (keys live outside the repo, e.g. ~/.ssh)
.secrets/
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
*_ed25519
*_ed25519.pub
# Local server access notes (accounts, hosts) — never committed
onprem.txt
