# Web container (copy to web.env — gitignored). Read per request: the same image serves any host.
# The SPA app registration (sign-in) and the API scope it asks for
AUD_WEB_TENANT_ID=<home-tenant-guid>
AUD_WEB_CLIENT_ID=<aud-web-spa-client-id>
AUD_WEB_API_SCOPE=api://<aud-api-app-client-id>/Azure.Read.All
# Optional — default is the origin the user opened. Must be https:// (or http://localhost) and registered on the SPA
# AUD_WEB_REDIRECT_URI=https://<on-prem-host>:8443/
