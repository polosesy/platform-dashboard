# API container (copy to api.env — gitignored). Names only here; never commit filled values.
NODE_ENV=production
# Home tenant + the SSO API app registration (token audience). Users need app roles AUD.Viewer/Operator/Admin.
AZURE_AD_TENANT_ID=<home-tenant-guid>
AZURE_AD_CLIENT_ID=<aud-api-app-client-id>
AUD_AUTH_AUDIENCES=api://<aud-api-app-client-id>
AZURE_SUBSCRIPTION_IDS=<subscription-guid>[,<subscription-guid>]
# The browser origin(s) the web is opened on
CORS_ORIGIN=https://<on-prem-host>:8443

# Platform identity (reads Azure): a certificate mounted read-only — ./config/platform.pem → /etc/aud/platform.pem
AUD_PLATFORM_CREDENTIAL=certificate
AUD_PLATFORM_CERT_PATH=/etc/aud/platform.pem
# (a client secret works too but is discouraged: AUD_PLATFORM_CREDENTIAL=secret + AZURE_AD_CLIENT_SECRET=…)

# Azure connections file (./config/connections.json → /etc/aud/connections.json); omit for one home connection
# AUD_CONNECTIONS_FILE=/etc/aud/connections.json
# AUD_CONN_<KEY>_SECRET=…   (servicePrincipal connections with secretEnv; prefer certificatePath)

AUD_AUDIT_LOG=stdout
AZURE_LIVE_DIAGRAM_ENABLED=true
AZURE_SECURITY_ENABLED=true
# Keyless public translator stays off in production; set AZURE_TRANSLATOR_KEY (+ REGION) for Service Health translation
# AZURE_TRANSLATOR_KEY=…
# AZURE_TRANSLATOR_REGION=koreacentral

# Corporate outbound proxy (API only — never on the web, whose /api proxy targets 127.0.0.1)
# Node's built-in fetch honours these only with NODE_USE_ENV_PROXY=1; the Azure SDK reads HTTPS_PROXY itself.
# The Kubernetes client does not use the proxy: private AKS API servers need a direct route (S2S/ExpressRoute + DNS).
# HTTPS_PROXY=http://<proxy>:<port>
# NO_PROXY=127.0.0.1,localhost,::1
# NODE_USE_ENV_PROXY=1
# NODE_EXTRA_CA_CERTS=/etc/aud/corp-ca.pem
