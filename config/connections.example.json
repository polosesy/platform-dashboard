{
  "connections": [
    {
      "key": "home",
      "displayName": "Home",
      "tenantId": "<HOME_TENANT_ID>",
      "mode": "platform",
      "subscriptions": []
    },
    {
      "key": "custa",
      "displayName": "Customer A",
      "tenantId": "<CUSTOMER_A_TENANT_ID>",
      "mode": "lighthouse",
      "subscriptions": [
        "<CUSTOMER_A_SUBSCRIPTION_ID>"
      ]
    },
    {
      "key": "custb",
      "displayName": "Customer B",
      "tenantId": "<CUSTOMER_B_TENANT_ID>",
      "mode": "servicePrincipal",
      "subscriptions": [
        "<CUSTOMER_B_SUBSCRIPTION_ID>"
      ],
      "clientId": "<CUSTOMER_B_APP_ID>",
      "secretEnv": "AUD_CONN_CUSTB_SECRET",
      "roles": [
        "operator",
        "admin"
      ],
      "logAnalyticsWorkspaces": [
        "<CUSTOMER_B_WORKSPACE_GUID>"
      ]
    }
  ]
}
