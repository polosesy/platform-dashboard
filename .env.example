# Shared
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# API server — listens on loopback by default (the web reaches it through its /api rewrite);
# container / VM deployments set 0.0.0.0 explicitly
PORT=4000
# API_BIND_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Verbose diagnostics (graph build, Hubble strategies, KQL row counts)
# AUD_DEBUG=true

# Azure AD (MSAL)
NEXT_PUBLIC_AZURE_AD_TENANT_ID=YOUR_TENANT_ID
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=YOUR_WEB_CLIENT_ID
NEXT_PUBLIC_AZURE_AD_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_AZURE_AD_API_SCOPE=api://YOUR_API_CLIENT_ID/user_impersonation

# API Azure OBO (confidential client)
AZURE_AD_TENANT_ID=YOUR_TENANT_ID
AZURE_AD_CLIENT_ID=YOUR_API_CLIENT_ID
AZURE_AD_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Sign-in (SSO) — every bearer token is verified. The platform role comes from the token's app roles
# (AUD.Viewer / AUD.Operator / AUD.Admin on aud-api — docs/integrations/azure/sso.md). Azure is read with each
# connection's platform credential, not the user's permissions (docs/integrations/azure/overview.md).
# NODE_ENV=development
# AUD_DEFAULT_ROLE=viewer          # role without an app-role assignment; development default viewer, production must be none
# AUD_AUDIT_LOG=stdout             # one JSON line per signed-in request (default stdout in production, off otherwise)
# AUD_HOME_CONNECTION_MODE=platform  # platform = the aud-api service principal (default) · delegated = each user's OBO
# AUD_PLATFORM_CERT_PATH=/abs/path/aud-api.pem   # certificate instead of AZURE_AD_CLIENT_SECRET (recommended)
#
# Anonymous callers get sample data or 401 signin_required. Local development only (loopback bind required):
# AUD_ANONYMOUS_SP=false          # anonymous reads with the service principal
# AUD_ANONYMOUS_K8S=false         # …including AKS sign-in / pod logs / Hubble exec (needs AUD_ANONYMOUS_SP too)
# AUD_AUTH_SCOPES=Azure.Read.All  # accepted delegated scopes of this API
# AUD_AUTH_AUDIENCES=             # default api://<AZURE_AD_CLIENT_ID>,<AZURE_AD_CLIENT_ID>

# Azure connections (customer tenants) — docs/integrations/azure/connect-tenant.md
# AUD_CONNECTIONS_FILE=config/connections.json   # never committed; unset = the home connection + AZURE_SUBSCRIPTION_IDS
# AUD_CONN_CUSTB_SECRET=                         # a servicePrincipal connection's secret, named by its "secretEnv"
# (AUD_TENANTS_FILE — the older "tenants" file — is still read)

# Azure — allow-list. Requests for any other subscription / resource ID are rejected (HTTP 400).
AZURE_SUBSCRIPTION_IDS=SUBSCRIPTION_ID_1,SUBSCRIPTION_ID_2

# Azure Log Analytics (Traffic Analytics) — the VNet traffic page (docs/observability/vnet-flow-logs.md)
# Workspace ID (GUID), not resource ID.
# AZURE_NETWORK_COVERAGE_TTL_MS=300000
AZURE_LOG_ANALYTICS_WORKSPACE_ID=YOUR_LOG_ANALYTICS_WORKSPACE_ID
AZURE_LOG_ANALYTICS_TABLE=NTANetAnalytics

# Azure Reservations (Consumption)
# AZURE_RESERVATIONS_GRAIN=monthly

# Boolean flags accept true/false, 1/0, yes/no, on/off.
# Cost / Security / Health are enabled by default — set to false to serve mock data only.

# Azure Cost Management
# AZURE_COST_MANAGEMENT_ENABLED=false
# AZURE_COST_CACHE_TTL_MS=300000

# Azure Security (Defender for Cloud)
# AZURE_SECURITY_ENABLED=false
# AZURE_SECURITY_CACHE_TTL_MS=300000
# Security posture is shown only to signed-in users (OBO). true = anonymous requests read live
# Defender data with the service principal — keep false outside local verification.
# AZURE_SECURITY_SP_FALLBACK=false

# Azure Resource Health
# AZURE_HEALTH_ENABLED=false
# AZURE_HEALTH_CACHE_TTL_MS=120000

# Live Diagram — Azure Monitor real integration
# Set to true to enable real Azure Monitor API calls for live diagrams.
# When false, mock data is used (safe for local dev without Azure).
# AZURE_LIVE_DIAGRAM_ENABLED=true
# AZURE_LIVE_METRICS_CACHE_TTL_MS=60000
# AZURE_MONITOR_ALERTS_CACHE_TTL_MS=60000

# Live Diagram — Application Insights (optional)
# Component name within the same resource group as your monitored resources.
# Used for edge bindings with source: "appInsights".
# AZURE_APP_INSIGHTS_APP_ID=your-appinsights-component-name
# AZURE_APP_INSIGHTS_CACHE_TTL_MS=60000

# NSG Flow Logs (from Azure Blob Storage)
# Storage account name where NSG flow logs are stored.
# AZURE_NSG_FLOW_LOG_STORAGE_ACCOUNT=your-storage-account
# AZURE_NSG_FLOW_LOG_CONTAINER=insights-logs-networksecuritygroupflowevent
# AZURE_NSG_FLOW_LOG_CACHE_TTL_MS=120000

# Traffic Analytics (live diagram edge traffic via NTANetAnalytics)
# Requires AZURE_LOG_ANALYTICS_WORKSPACE_ID to be set.
# AZURE_TRAFFIC_ANALYTICS_ENABLED=true
# AZURE_TRAFFIC_ANALYTICS_CACHE_TTL_MS=60000

# Connection Monitor (latency/packet loss via Network Watcher)
# AZURE_CONNECTION_MONITOR_ENABLED=true
# AZURE_CONNECTION_MONITOR_CACHE_TTL_MS=120000

# Observability (Container Insights + Managed Prometheus)
# Workspace / Prometheus endpoint are auto-discovered from the AKS cluster when unset.
# AZURE_CONTAINER_INSIGHTS_WORKSPACE_ID=YOUR_CONTAINER_INSIGHTS_WORKSPACE_GUID
# AZURE_PROMETHEUS_ENDPOINT=https://<workspace>.<region>.prometheus.monitor.azure.com
# AZURE_OBSERVABILITY_CACHE_TTL_MS=60000

# Cilium Hubble (AKS network flows via `hubble observe` in the cilium agent pod)
# ── AKS (docs/integrations/azure/aks.md) ──
# AUD_AKS_ALLOW_LOCAL_ACCOUNTS=false   # dev only: clusters WITHOUT Entra (cluster-admin certificate); production refuses true
# AUD_AKS_PROBE_TIMEOUT_MS=3000        # DNS / TCP 443 pre-flight per step (private clusters fail fast)
# HUBBLE_ENABLED=true
# HUBBLE_EXEC_ENABLED=                 # exec into cilium-agent (node access): unset = on in dev, off in production
# HUBBLE_RELAY_NAMESPACE=kube-system
# HUBBLE_RELAY_PORT=80
# HUBBLE_FLOW_LIMIT=10000
# HUBBLE_CACHE_TTL_MS=30000
