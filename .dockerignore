# Never in the image or the build context: secrets, tenant data, local probes, build outputs
.git
**/node_modules
**/.next
**/dist
*.tsbuildinfo
.env
.env.*
config/
deploy/docker/config/
deploy/docker/*.env
.claude/
apps/api/.probe/
docs/
SESSION_SUMMARY.md
skill.md
**/*.pem
**/*.pfx
# Local access material and notes (SSH keys, server addresses, real-environment notes) — a build from the working
# folder (az acr build ., docker build .) must never upload them
.secrets/
onprem.txt
**/*.key
**/*.ppk
**/id_rsa*
**/id_ed25519*
**/*_ed25519
**/*_ed25519.pub
*.local.md
local/
deploy/docker/tls/
state/
